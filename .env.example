# =========================================================
# QuantSolutions — Root Environment Reference
# This file documents every environment variable used across
# the project. Actual values are set in frontend/.env and
# backend/.env (both are git-ignored) or in your host's
# environment variable settings (Render / Netlify dashboards).
# =========================================================

# ---------------------------------------------------------
# Backend (backend/.env)
# ---------------------------------------------------------
NODE_ENV=development
PORT=5000

DATABASE_URL=postgresql://user:password@localhost:5432/quantsolutions
DATABASE_SSL=false

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="QuantSolutions <no-reply@quantsolutions.com>"

# Recipient for internal operational alerts (deposit/withdrawal requests)
ADMIN_EMAIL=operations@quantsolutions.com

CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------
# Frontend (frontend/.env)
# ---------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api
