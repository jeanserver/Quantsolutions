NODE_ENV=development
PORT=5000

DATABASE_URL=postgresql://user:password@localhost:5432/quantsolutions
DATABASE_SSL=false

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="QuantSolutions <no-reply@quantsolutions.com>"

# Recipient for internal operational alerts (deposit/withdrawal requests)
ADMIN_EMAIL=operations@quantsolutions.com

CLIENT_URL=http://localhost:5173
